# QuotaPets server configuration.
# Copy to .env for local development, or set these in your host's UI
# (Coolify: Environment Variables, with "Build Variable" OFF).
#
# NOTE: the server does not read .env itself. This file is documentation;
# your process manager or platform is what injects the values.

# ---- Required ----------------------------------------------------------
# Minimum 32 characters. The process refuses to start without it, on purpose:
# a quota dashboard that fails open is a quota dashboard that gets indexed.
#   openssl rand -hex 32
AUTH_TOKEN=

# ---- Optional (defaults shown) -----------------------------------------
PORT=3000
HOST=0.0.0.0

# Where the snapshot cache and the vendor CLI credentials live.
# Mount this as a persistent volume so a redeploy doesn't force a re-login.
DATA_DIR=/data
CLAUDE_CONFIG_DIR=/data/claude
CODEX_HOME=/data/codex

# How often each provider is polled, and how far apart the two are staggered
# so they never fire in the same instant.
POLL_INTERVAL_SEC=60
CODEX_STAGGER_SEC=30

# Set to 1 to log the vendor CLI's own output during sign-in. Off by default:
# that output can contain the device verification URL and user code.
DEBUG_LOGIN=0
