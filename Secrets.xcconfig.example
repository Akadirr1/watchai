// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
//
// This is the whole file: the server URL and nothing else. The watch has no token baked
// into it — on first launch it shows a QR, you scan it with your iPhone camera while
// signed in to the server, and the device token it receives lives in the Keychain. That
// means you can rotate AUTH_TOKEN or revoke a watch without rebuilding the app.
//
// Note the escaped slashes: xcconfig treats // as a comment, so a bare URL would be
// truncated at the scheme.
QUOTAPETS_API_URL = https:/$()/pets.example.com
